# Terraform — never commit these.
# NOTE: git does NOT support trailing inline comments on patterns,
# so every comment must be on its own line.

.terraform/
.terraform.lock.hcl
crash.log

# State can contain secrets — never commit
*.tfstate
*.tfstate.*

# Real variable values (project IDs, IPs) — keep only the example
*.tfvars
!*.tfvars.example

override.tf
override.tf.json
