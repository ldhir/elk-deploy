# Copy to .env and tweak as needed:  cp .env.example .env
# (.env is git-ignored — never commit real values.)

ELK_VERSION=8.13.4

# Heap for Elasticsearch. Rule of thumb: ~50% of the VM's RAM, max 1g on a
# free-tier box. Oracle free tier (1GB) -> use 512m. 2GB+ -> 1g.
ES_HEAP=512m

# Host ports (left side of the mapping)
ES_PORT=9200
KIBANA_PORT=5601
BEATS_PORT=5044

# Password for the 'elastic' superuser. SET A STRONG ONE.
# Used by Logstash to write, and by YOU to log into the Kibana UI.
# Generate: openssl rand -hex 24
ELASTIC_PASSWORD=change_me_to_a_strong_password

# Password for the built-in 'kibana_system' service account (Kibana->ES auth).
# After ES is up, set it with:
#   curl -u elastic:$ELASTIC_PASSWORD -X POST \
#     localhost:9200/_security/user/kibana_system/_password \
#     -H 'Content-Type: application/json' -d "{\"password\":\"$KIBANA_PASSWORD\"}"
KIBANA_PASSWORD=change_me_to_another_strong_password
